            "text": "The baseUri of the collection config holds \"{ID}\"; an ERC-1155 client replaces only the exact text {id}. Fix: Write the placeholder as {id}, in small letters with no space, and put it in the base URI where the id goes."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/collection.json",
